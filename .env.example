# SmartBuy AI — Production environment variables
# DO NOT put real values in this file or in git. Set real values only in
# your hosting dashboard (Netlify / Vercel environment settings).
# Copy this file to .env.local for local testing only — .env files are git-ignored.

# --- Required: Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Required: App URL (your production domain, no trailing slash) ---
NEXT_PUBLIC_APP_URL=https://yourdomain.com
# NOTE: NEXT_PUBLIC_SITE_URL is NOT read by the code — use
# NEXT_PUBLIC_APP_URL above. Do not set NEXT_PUBLIC_SITE_URL expecting
# an effect.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# --- Stripe (start in TEST mode, switch to live only after test checkout passes) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs (Section 15 P2-1/P2-7): all optional, unset = that tier
# cannot be bought. STRIPE_PRO_PRICE_ID is a deprecated alias for
# STRIPE_PREMIUM_PRICE_ID. No dollar amount is set here — the live
# price decision ($1 vs $4.99 vs $9.99) is the owner's.
STRIPE_PREMIUM_PRICE_ID=price_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_FAMILY_PRICE_ID=price_...
# STRIPE_TEAM_PRICE_ID=price_...
# STRIPE_STARTER_PRICE_ID=price_...
# STRIPE_TRIAL_DAYS=0
# Flip to live only after the Section 15 P2-9 checklist is complete.
# STRIPE_LIVE_LAUNCHED=true

# --- Email (Resend) ---
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# RESEND_FROM is accepted as an alias for EMAIL_FROM_ADDRESS (either
# name works; EMAIL_FROM_ADDRESS wins when both are set).
# RESEND_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=SmartBuy AI
# NOTE: RESEND_FROM_EMAIL / RESEND_FROM_NAME are NOT read by the code —
# the canonical names are EMAIL_FROM_ADDRESS / EMAIL_FROM_NAME above.
# Do not set the RESEND_FROM_* names expecting an effect.
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# RESEND_FROM_NAME=SmartBuy AI

# --- Push notifications (VAPID — generate at deploy time, never commit) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- WhatsApp & Telegram alert webhooks (owner setup, all optional) ---
# WhatsApp needs a Meta Business app + an approved template; Telegram
# needs a bot token from BotFather. When unset, those channels report
# "not_configured" and are skipped — never a fake "sent" status.
# Set real values ONLY in the hosting dashboard, never here.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEMPLATE_NAME=price_drop_alert
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# (TELEGRAM_CHAT_ID is the chat/group the bot posts alerts to. The
# current code reads TELEGRAM_BOT_TOKEN; TELEGRAM_CHAT_ID is reserved
# for the alert-sending path — set it when wiring Telegram alerts.)

# --- Smart-home webhook (owner setup, optional) ---
# Shared secret for the smart-home webhook receiver (lib/smart-home-agent.ts).
# Minimum 16 characters. Unset → the webhook returns 503. Set the real
# value ONLY in the hosting dashboard, never here.
# SMART_HOME_WEBHOOK_SECRET=

# --- Cron protection (strong random string, used as Bearer token) ---
CRON_SECRET=

# --- eBay (owner setup — code-complete, keys-gated) ---
# eBay Browse API, OAuth client-credentials flow (services/ebay-browse.ts).
# Without EBAY_CLIENT_ID + EBAY_CLIENT_SECRET every eBay call fails
# closed and the eBay intake/refresh legs stay inert. EBAY_MARKETPLACE_ID
# defaults to EBAY_US when unset. Set real values ONLY in the hosting
# dashboard, never here. NOTE: EBAY_ENVIRONMENT is NOT read by the code.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE_ID=EBAY_US
# The eBay pipeline also needs an `ebay` row in the live `merchants`
# table (no seed creates it) and migration 041 for daily-cap tracking.

# --- Optional: visual-search vector upgrade (Delta 1) ---
# Dormant until a token is set AND the SQL + backfill below are run.
# Create a free account at huggingface.co, then a token at
# huggingface.co/settings/tokens (read-only is enough). Set the real
# token ONLY in the hosting dashboard, never here. Without it,
# POST /api/v1/visual-search answers 503 and the backfill refuses.
HF_API_TOKEN=
# Optional Hugging Face Spaces vars (reserved — NOT read by the current
# code; the visual-search path reads HF_API_TOKEN only). Leave unset
# unless a future Spaces-backed path documents them.
# HF_SPACES_BASE_URL=
# NEXT_PUBLIC_HF_SPACES_BASE_URL=
# HF_SPACES_TOKEN=

# --- External web search fallback (SerpAPI Google Shopping) ---
# Optional. When unset, search is catalog-only and the web fallback is
# disabled (no crash). Set the real key ONLY in Netlify env vars, never here.
# Free plan is small (~100-250 searches/month, verify on serpapi.com/pricing);
# results are cached for 7 days so repeat queries do not spend quota.
SERPAPI_API_KEY=
# NOTE: SEARCH_API_KEY is NOT read by the current code — the search
# fallback reads SERPAPI_API_KEY only.
# SEARCH_API_KEY=

# --- Optional: product analytics (PostHog) ---
# Dormant until a key is set AND the visitor accepts analytics in the
# cookie banner. Create a free account at posthog.com for the key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Optional: analytics (GA4 + Meta Pixel) ---
# GA4 + Meta Pixel are read by components/providers/analytics-config.ts.
# With no ID set the vendor stays dormant. NOTE: the code reads
# NEXT_PUBLIC_GA4_ID (not NEXT_PUBLIC_GA_ID).
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=
# NOTE: NEXT_PUBLIC_MIXPANEL_TOKEN is NOT read by the current code.
# NEXT_PUBLIC_MIXPANEL_TOKEN=

# --- Optional: error monitoring ---
# Set the DSN after creating a free Sentry account (sentry.io) — the
# SDK stays dormant until a DSN is set. SENTRY_ORG/PROJECT/AUTH_TOKEN
# are only needed for source-map upload at build time.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
LOG_LEVEL=info

# --- Optional: auth toggles ---
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
NEXT_PUBLIC_ENABLE_EMAIL_VERIFICATION=false

# --- Optional / future providers (leave blank unless you use them) ---
OPENAI_API_KEY=
APIFY_API_TOKEN=
APIFY_API_BASE_URL=
APIFY_ACTOR_ID=
REDIS_URL=
# Upstash Redis (REST) — distributed rate limiting. Free tier at
# console.upstash.com: create a Redis database, copy its REST URL +
# REST token, set them in Vercel (Production) and redeploy. Until
# they are set, rate limiting uses the in-memory per-instance bucket
# (partial protection on serverless). Never commit real values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# NOTE: the bare R2_* names (R2_ACCOUNT_ID etc.) are NOT read by the
# code — use the CLOUDFLARE_R2_* names above. R2_BUCKET is not read
# by the current code either.
# R2_BUCKET=

# --- Optional: geo affiliate engine (Phase 3 Prep) ---
# Leave ALL of these blank to keep plain retailer links: with nothing
# configured, no tag is injected, no Skimlinks wrap happens, and no
# affiliate disclosure note renders. Fill ONLY with real accounts you
# own — never copy a tag from code, docs, or another site.
# US visitors use AMAZON_ASSOC_TAG; every other country needs its own
# AMAZON_ASSOC_TAG_<CC> override (GB, DE, JP, CA, AU, IN, ...).
AMAZON_ASSOC_TAG=
AMAZON_ASSOC_TAG_GB=
AMAZON_ASSOC_TAG_DE=
# Skimlinks secondary fallback (wraps non-Amazon links when set).
# Confirm the redirect format in your Skimlinks dashboard first.
SKIMLINKS_PUBLISHER_ID=
