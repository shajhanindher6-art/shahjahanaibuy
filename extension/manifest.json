{
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "matches": [
        "https://*.amazon.com/*",
        "https://*.walmart.com/*",
        "https://*.bestbuy.com/*",
        "https://*.ebay.com/*",
        "https://*.aliexpress.com/*",
        "https://*.daraz.pk/*",
        "https://*.daraz.com.bd/*",
        "https://*.daraz.lk/*",
        "https://*.daraz.com.np/*",
        "https://*.priceoye.pk/*",
        "https://*.noon.com/*",
        "https://*.jumia.com.ng/*",
        "https://*.jumia.com.eg/*",
        "https://*.jumia.co.ke/*",
        "https://*.jumia.ma/*",
        "https://*.jumia.ci/*",
        "https://*.jumia.sn/*",
        "https://*.jumia.ug/*",
        "https://*.jumia.com.gh/*",
        "https://*.flipkart.com/*"
      ]
    }
  ],
  "description": "Find better prices across Amazon, Walmart, Best Buy, eBay, AliExpress, Daraz, PriceOye, Noon, Jumia, and Flipkart while you shop, and apply SmartBuy coupon codes at checkout.",
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.walmart.com/*",
    "https://*.bestbuy.com/*",
    "https://*.ebay.com/*",
    "https://*.aliexpress.com/*",
    "https://*.daraz.pk/*",
    "https://*.daraz.com.bd/*",
    "https://*.daraz.lk/*",
    "https://*.daraz.com.np/*",
    "https://*.priceoye.pk/*",
    "https://*.noon.com/*",
    "https://*.jumia.com.ng/*",
    "https://*.jumia.com.eg/*",
    "https://*.jumia.co.ke/*",
    "https://*.jumia.ma/*",
    "https://*.jumia.ci/*",
    "https://*.jumia.sn/*",
    "https://*.jumia.ug/*",
    "https://*.jumia.com.gh/*",
    "https://*.flipkart.com/*",
    "https://shahjahanaibuy-b1zp.vercel.app/*"
  ],
  "homepage_url": "https://shahjahanaibuy-b1zp.vercel.app/extension",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "manifest_version": 3,
  "name": "SmartBuy AI \u2014 Price Comparison & Coupons",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "alarms"
  ],
  "version": "2.0.0"
}
