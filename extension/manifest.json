{
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "matches": [
        "https://*.amazon.com/*",
        "https://*.walmart.com/*",
        "https://*.bestbuy.com/*",
        "https://*.ebay.com/*",
        "https://*.aliexpress.com/*"
      ]
    }
  ],
  "description": "Find better prices across Amazon, Walmart, Best Buy, eBay, and AliExpress while you shop, and apply SmartBuy coupon codes at checkout.",
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.walmart.com/*",
    "https://*.bestbuy.com/*",
    "https://*.ebay.com/*",
    "https://*.aliexpress.com/*",
    "https://aismartbuy.netlify.app/*"
  ],
  "manifest_version": 3,
  "name": "SmartBuy AI \u2014 Price Comparison & Coupons",
  "permissions": [
    "activeTab",
    "storage",
    "notifications"
  ],
  "version": "1.1.0"
}
